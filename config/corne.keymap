#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/modifiers.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    behaviors {
        dot_colon_morph: dot_colon_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp COLON>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        minus_under_morph: minus_under_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp UNDER>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        comma_semi_morph: comma_semi_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        lower_raise_adjust {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
                bindings = <
                    &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LS(TAB)
                    &kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp BSPC  &kp ESC
                    &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &comma_semi_morph  &dot_colon_morph  &minus_under_morph  &kp RSHFT
                    &kp LGUI  &mo LOWER  &kp SPACE  &kp RET  &mo RAISE  &kp RALT
                >;
            };

        lower {
                bindings = <
                    &trans  &trans  &kp DQT  &trans  &trans  &trans  &trans  &kp N7  &kp N8  &kp N9  &trans  &trans
                    &trans  &trans  &trans  &trans  &kp SLASH  &trans  &trans  &kp N4  &kp N5  &kp N6  &trans  &trans
                    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N1  &kp N2  &kp N3  &kp N0  &trans
                    &trans  &trans  &trans  &trans  &trans  &trans
                >;
            };

        raise {
                bindings = <
                    &trans  &trans  &trans  &kp LBKT  &kp RBKT  &trans  &trans  &trans  &kp EQUAL  &kp GRAVE  &trans  &trans
                    &trans  &trans  &trans  &kp LPAR  &kp RPAR  &trans  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp SQT  &trans
                    &trans  &kp LT  &kp GT  &kp LBRC  &kp RBRC  &trans  &trans  &kp QMARK  &kp EXCL  &kp TILDE  &trans  &trans
                    &trans  &trans  &trans  &trans  &trans  &trans
                >;
            };

        alternate {
                bindings = <
                    &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
                    &rgb_ug RGB_TOG  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &trans  &trans  &kp C_PP  &kp C_VOL_UP  &kp C_BRI_UP  &trans
                    &rgb_ug RGB_EFF  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans  &kp C_VOL_DN  &kp C_BRI_DN  &trans
                    &trans  &trans  &trans  &trans  &trans  &trans
                >;
            };
    };
};

&led_strip {
    chain-length = <27>;
};
