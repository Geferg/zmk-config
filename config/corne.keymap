#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        lower_raise_adjust {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
                bindings = <
                    &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &trans
                    &kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &trans  &kp BSPC
                    &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                    &kp LGUI  &mo LOWER  &kp SPACE  &kp RET  &mo RAISE  &kp RALT
                >;
            };

        lower {
                bindings = <
                    &trans  &kp PIPE  &trans  &trans  &kp LBKT  &kp RBKT  &trans  &kp N7  &kp N8  &kp N9  &kp PLUS  &kb NON_US_BSLH
                    &trans  &kp AMPERSAND  &trans  &trans  &kp LBRC  &kp RBRC  &kp KP_EQUAL  &kp N4  &kp N5  &kp N6  &kp ASTRK  &trans
                    &trans  &kp CARET  &kp LT  & GT  &kp LPAR  &kp RPAR  &trans  &kp N1  &kp N2  &kp N3  &kp MINUS  &trans
                    &trans  &trans  &trans  &trans  &trans  &kp N0
                >;
            };

        raise {
                bindings = <
                    &trans  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT  &trans  &trans  &trans  &trans  &trans  &kp SQT  &trans
                    &trans  &kp DOUBLE_QUOTES  &kp EXCL  &kp QMARK  &kp KP_SLASH  &trans  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp SEMI  &trans
                    &trans  &kp SINGLE_QUOTE  &kp GRAVE  &trans  &kp TILDE2  &trans  &trans  &trans  &trans  &trans  &kp LBKT  &trans
                    &trans  &trans  &trans  &trans  &trans  &trans
                >;
            };

        alternate {
                bindings = <
                    &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans  &trans  &trans  &trans
                    &trans  &rgb_ug RGB_TOG  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &trans  &trans  &trans  &kp C_PREV  &kp C_PP  &kp C_NEXT  &trans  &trans
                    &trans  &rgb_ug RGB_EFF  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                    &trans  &trans  &trans  &trans  &trans  &trans
                >;
            };
    };
};
